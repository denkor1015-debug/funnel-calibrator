# Secrets and local configuration
.env
.env.local
*.key
*.pem

# Real (non-anonymised) data — never commit
data/raw/
data/*.raw.json
data/*.private.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Obsidian's own vault state. Never commit: the Local REST API plugin stores
# its API key and generated certificate in .obsidian/plugins/*/data.json, and
# workspace.json is local UI state. The instructor installs the plugin from
# the community catalogue — see demo-vault/README.md.
demo-vault/.obsidian/
.obsidian/
