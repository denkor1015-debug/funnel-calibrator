# ─── Funnel Calibrator ────────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# Path to the anonymised snapshot dataset used by the server.
FC_SNAPSHOT_PATH=data/snapshot.json

# Per-product price and cost. Defaults to economics.json beside the snapshot.
# FC_ECONOMICS_PATH=data/economics.json

# Cohort maturity: orders younger than this many days are treated as
# unresolved and excluded from rate measurement (COD delivery + return
# cycle). Lower values react faster but bias rates downward.
FC_COHORT_MATURITY_DAYS=21

# Minimum resolved orders required before a measurement is reported as
# reliable. Below this, tools return reliability="insufficient".
FC_MIN_SAMPLE=30

# Ratio of Goal CPL to Stop CPL (the optimisation target sits below
# break-even to leave margin for measurement error).
FC_GOAL_RATIO=0.70

# UAH per USD. Ad spend is denominated in USD, economics in UAH.
FC_USD_UAH=45.0

# ─── Obsidian Local REST API (existing MCP server) ────────────────────
# The plugin generates this key; store it here, never in source.
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1

# 27123 is the plugin's plain-HTTP listener, which must be enabled in its
# settings. Its HTTPS port (27124) presents a self-signed certificate that
# Node rejects, so the agent's connection fails there while a probe with
# verification disabled succeeds — a confusing pair of symptoms. To keep TLS
# instead, set OBSIDIAN_PORT=27124 and point OBSIDIAN_CA_CERT at the
# certificate the plugin exports. See demo-vault/README.md.
OBSIDIAN_PORT=27123
# OBSIDIAN_CA_CERT=/absolute/path/to/obsidian-local-rest-api.crt

# ─── Snapshot export only (not needed to run the server) ──────────────
# Shared secret for the CRM worker. Read from the environment or from
# ~/.config/malvia/mcp.key. Never place a real value in this file.
# KEYCRM_MCP_SECRET=
# FC_BUSINESS_REPO=/absolute/path/to/business/repo
